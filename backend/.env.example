# Database
# Postgres (Neon). A pooled precisa do sufixo -pooler no host.
DATABASE_URL="postgresql://user:senha@host-pooler.regiao.aws.neon.tech/dbname?sslmode=require"
# Conexao direta, usada so pelas migrations (pooler nao roda DDL confiavel).
DIRECT_URL="postgresql://user:senha@host.regiao.aws.neon.tech/dbname?sslmode=require"

# Server
PORT=4000
NODE_ENV=development

# Frontend origin allowed to make credentialed requests (CORS)
CORS_ORIGIN="http://localhost:5173"

# JWT secrets — MUST be long, random, unique per environment.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-please"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars-please"

# Token lifetimes
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=7

# Account lockout policy
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Cookie security (set true behind HTTPS in production)
COOKIE_SECURE=false

# --- Prospecting (garimpo de leads) ---
# Nominatim e Overpass exigem um User-Agent que identifique a aplicacao e de um
# contato. Troque o e-mail abaixo pelo seu antes de usar em volume.
PROSPECTING_USER_AGENT="SeuCRM/1.0 (prospecting; seu-email@dominio.com.br)"
# Endpoint do Overpass. O fallback so e usado quando o principal responde
# "sem slot livre" (HTTP 429/504).
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_FALLBACK_URL=https://overpass.kumi.systems/api/interpreter
# Opcional: com a chave definida, a fonte "Google Places" fica selecionavel.
# Sem ela, o app funciona normalmente so com o OpenStreetMap.
GOOGLE_PLACES_API_KEY=
# Visita o site de cada lead para extrair e-mail/Instagram/WhatsApp.
# Defina "false" para desligar o enriquecimento.
ENRICHMENT_ENABLED=true
# Quanto tempo uma fatia do garimpo pode trabalhar antes de retornar.
# Precisa ficar bem abaixo do timeout de requisicao do host (Vercel: 300s).
PROSPECTING_SLICE_MS=45000
# Defina "true" APENAS em host sempre ligado (Railway, VPS): faz o garimpo
# terminar sozinho. Em serverless o loop de fundo e congelado e o job para.
PROSPECTING_INLINE=false

# --- E-mail (redefinicao de senha) ---
# Sem uma chave, o app ESCREVE a mensagem no log em vez de enviar. Isso serve
# para desenvolvimento e nao funciona em producao: o endpoint devolve
# emailConfigured:false e a tela avisa quem pediu.
# Crie a chave em https://resend.com (tier gratuito).
RESEND_API_KEY=
# Precisa ser um remetente verificado no seu dominio. Para testar, o Resend
# permite "onboarding@resend.dev" enviando para o e-mail da propria conta.
EMAIL_FROM="Insights CRM <onboarding@resend.dev>"
# Origem publica usada para montar o link do e-mail. Tem que ser o endereco que
# a pessoa abre no navegador, nao o dominio da API.
APP_URL=http://localhost:5173
PASSWORD_RESET_TTL_MINUTES=30
