node_modules/
dist/
build/

# Secrets and local database — never commit these.
.env
.env.*
!.env.example
*.db
*.db-journal
*.sqlite

# Local tooling
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.log

# Local editor/agent settings (machine-specific)
.claude/settings.local.json

.vercel
.env*

# The negation has to come after the broad .env* rule above, or the example
# file (which carries only placeholders) gets ignored too.
!.env.example
